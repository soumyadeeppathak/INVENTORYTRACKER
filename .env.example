# Database
DATABASE_URL="postgresql://user:password@localhost:5432/inventorytracker"

# Email Provider (choose one: "resend" or "brevo")
EMAIL_PROVIDER="brevo"

# Resend (if using Resend)
RESEND_API_KEY=""

# Brevo (if using Brevo - recommended, no domain needed)
BREVO_API_KEY=""

# Email From Address
EMAIL_FROM="InventoryTracker <noreply@yourdomain.com>"

# Session
SESSION_SECRET="your-32-character-secret-key-here"

# App URL (for magic links)
NEXT_PUBLIC_APP_URL="http://localhost:4000"
